.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Git
.git/
.gitignore

# Tests (not needed at runtime)
tests/

# Documentation (not needed at runtime)
*.md
asset/
bugs.md
ROADMAP.md
PRODUCT_IDEAS.md
PROTOTYPE_README.md
