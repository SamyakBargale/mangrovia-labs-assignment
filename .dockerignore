# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Environment files — never bake secrets into images
.env
.env.*
!.env.example

# Database files — should be in a mounted volume, not in the image
*.db
*.sqlite3

