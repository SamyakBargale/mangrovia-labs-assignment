# ── Required ─────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# The numeric chat ID the bot will operate in.
# Easy way to find it: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890

# ── Demo mode (free, no Anthropic calls) ─────────────────────────────────────
# Set to true for local testing — uses a deterministic pricing heuristic.
# Set to false for real AI pricing and negotiation.
DEMO_MODE=true

# ── Anthropic (only needed when DEMO_MODE=false) ──────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Database ──────────────────────────────────────────────────────────────────
# File path for the SQLite database.
# In Docker: set to /app/data/bot.db and mount /app/data as a volume.
DATABASE_PATH=./bot.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Telegram group behaviour ──────────────────────────────────────────────────
# "all"              — bot reads every message in the chat.
#                      Requires BotFather privacy mode DISABLED for the bot.
# "reply_or_mention" — bot reads only replies to it or @mentions.
#                      Works with BotFather privacy mode ENABLED.
GROUP_TRIGGER_MODE=all
BOT_USERNAME=

# ── Session management ────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=60

# ── Negotiation strategy ──────────────────────────────────────────────────────
# Opening offer as a fraction of the low-end estimate (0.85 = open 15% below low)
INITIAL_OFFER_RATIO=0.85

# Maximum transcript turns sent to the LLM per step (older turns omitted)
MAX_HISTORY_TURNS=20

# Default currency when the listing does not specify one
DEFAULT_CURRENCY=EUR

# ── Webhook deployment (leave blank to use long-polling) ──────────────────────
# Public HTTPS base URL of your server, e.g. https://bot.example.com
# Leave empty to run in long-polling mode (recommended for local dev).
WEBHOOK_URL=
WEBHOOK_PORT=8443

# Optional secret token Telegram will send with each webhook request.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET_TOKEN=

# ── Web App (Telegram Mini App) ───────────────────────────────────────────────
# URL of the FastAPI dashboard server. Must be HTTPS to open inside Telegram as
# a Mini App. For local development use an SSH tunnel (see README for ngrok /
# localhost.run instructions). If left as http://, the bot will fall back to a
# standard browser link automatically.
WEBAPP_URL=http://localhost:8000/

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Maximum messages a single user may send per RATE_LIMIT_WINDOW_SECONDS.
# Set RATE_LIMIT_MESSAGES=0 to disable rate limiting entirely.
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
